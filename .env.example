# =============================================================================
# Portfolio Environment Variables
# =============================================================================
#
# Formspree Contact Form Integration (Optional):
# 1. Sign up for a free account at https://formspree.io
# 2. Click "+ New Form" and give it a name (e.g., "Portfolio Contact Form")
# 3. Copy the 8-character form endpoint ID (e.g. "xpwzabcd" from https://formspree.io/f/xpwzabcd)
# 4. Duplicate this file, rename it to `.env` (or `.env.local`), and paste your ID below:
#
# VITE_FORMSPREE_ID=your_formspree_id_here
#
# Note: Never commit your `.env` file to public GitHub repositories.
# When VITE_FORMSPREE_ID is omitted, the contact form automatically falls back
# to opening the visitor's default email client with a pre-filled email draft.
# =============================================================================

VITE_FORMSPREE_ID=
